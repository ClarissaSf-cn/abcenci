# Contoh Environment Variables untuk Railway Dashboard
# Salin variabel ini ke menu "Variables" di project Railway Anda

APP_NAME="Sistem Absensi Indofood"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:QtgvgEf/ujCYBAQtqLHND7KZWiyKppLLbPAdPyJDK4U=
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

# Database (Neon PostgreSQL)
DB_CONNECTION=pgsql
# Masukkan DATABASE_URL dari Neon DB Anda:
DATABASE_URL=postgresql://neondb_owner:...@ep-...-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:...@ep-...ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Driver Session, Cache & Queue (Memanfaatkan Neon DB)
SESSION_DRIVER=database
SESSION_LIFETIME=1440
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

LOG_CHANNEL=stderr
LOG_LEVEL=info

